---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-clase.jpg';
import { hero } from '../data/content';
import { site } from '../data/site';
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <Image
      src={heroImage}
      alt=""
      widths={[720, 1080, 1600, 2200]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero__img"
    />
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__content">
    <p class="hero__brand">{site.name}</p>
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-title" class="hero__title">{hero.title}</h1>
    <p class="hero__intro">{hero.intro}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={hero.primaryCta.href} data-track="hero-cursos">
        {hero.primaryCta.label}
      </a>
      <a class="btn btn--ghost-light" href={hero.secondaryCta.href} data-track="hero-youtube">
        {hero.secondaryCta.label}
      </a>
    </div>
    <a class="hero__tertiary" href={hero.tertiaryCta.href} data-track="hero-marcas">
      {hero.tertiaryCta.label}
    </a>
  </div>

  <div class="hero__strip">
    <div class="container hero__strip-grid">
      <div>
        <strong>Praga Escuela de Conductores</strong>
        <span>Cursos de manejo en Córdoba</span>
      </div>
      <div>
        <strong>Práctica + teoría</strong>
        <span>Educación vial y clases reales</span>
      </div>
      <div>
        <strong>{hero.imageCaption}</strong>
        <span>Consultá disponibilidad con Praga</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100vh, 56rem);
    display: grid;
    align-items: end;
    color: #fff;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(15, 22, 28, 0.42) 0%, rgba(15, 22, 28, 0.28) 38%, rgba(15, 22, 28, 0.72) 100%),
      linear-gradient(90deg, rgba(16, 118, 77, 0.18), transparent 58%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: 3.5rem;
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
  }

  .hero__brand {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .hero__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9ad9ba;
  }

  .hero__title {
    margin: 0 0 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 4.4rem);
    font-weight: 750;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .hero__intro {
    margin: 0 auto 1.75rem;
    max-width: 40rem;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: rgba(255, 255, 255, 0.88);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-bottom: 1.1rem;
  }

  .hero__tertiary {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hero__strip {
    position: relative;
    z-index: 1;
    background: rgba(20, 24, 30, 0.92);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero__strip-grid {
    display: grid;
    gap: 1.25rem;
    padding-block: 1.35rem;
  }

  .hero__strip-grid div {
    display: grid;
    gap: 0.2rem;
  }

  .hero__strip-grid strong {
    font-family: var(--font-display);
    font-size: 1rem;
    color: #fff;
  }

  .hero__strip-grid span {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (min-width: 768px) {
    .hero__strip-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .hero__img {
      object-position: center 32%;
    }
  }
</style>
