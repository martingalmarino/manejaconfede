---
import { site } from '../data/site';
import { nav } from '../data/content';
---

<a class="skip-link" href="#contenido-principal">Saltar al contenido</a>

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="wordmark" href="#inicio" data-track="nav-home">
      <span class="wordmark__mark" aria-hidden="true"></span>
      <span>{site.name}</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-principal"
      data-menu-toggle
    >
      <span class="menu-toggle__bars" aria-hidden="true"></span>
      <span class="visually-hidden">Abrir menú</span>
    </button>

    <nav class="nav" id="nav-principal" data-nav aria-label="Principal">
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary header-cta" href="#cursos" data-track="header-cursos">
        Consultar cursos
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--header-h);
    background: transparent;
    transition:
      background 200ms ease,
      box-shadow 200ms ease,
      backdrop-filter 200ms ease;
  }

  .site-header.is-solid {
    position: fixed;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(14px);
    box-shadow: 0 8px 30px rgba(31, 35, 40, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: #fff;
    white-space: nowrap;
  }

  .site-header.is-solid .wordmark {
    color: var(--color-charcoal);
  }

  .wordmark__mark {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background:
      conic-gradient(from 210deg, var(--color-green), var(--color-blue), var(--color-green));
    box-shadow: inset 0 0 0 4px rgba(255, 255, 255, 0.2);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.08);
    cursor: pointer;
  }

  .site-header.is-solid .menu-toggle {
    border-color: var(--color-border);
    background: var(--color-surface);
  }

  .menu-toggle__bars,
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    display: block;
    width: 1.15rem;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    position: relative;
    transition: transform 160ms ease;
  }

  .site-header.is-solid .menu-toggle__bars,
  .site-header.is-solid .menu-toggle__bars::before,
  .site-header.is-solid .menu-toggle__bars::after {
    background: var(--color-charcoal);
  }

  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .menu-toggle__bars::before {
    top: -6px;
  }

  .menu-toggle__bars::after {
    top: 6px;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bars {
    background: transparent;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .nav {
    display: none;
  }

  .nav.is-open {
    display: flex;
    position: absolute;
    left: 0;
    right: 0;
    top: var(--header-h);
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem var(--gutter) 1.5rem;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
  }

  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav__list a {
    display: flex;
    align-items: center;
    min-height: var(--tap-min);
    padding-inline: 0.35rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-charcoal);
  }

  .nav__list a:hover {
    color: var(--color-green);
  }

  .header-cta {
    width: 100%;
  }

  @media (min-width: 900px) {
    .menu-toggle {
      display: none;
    }

    .nav {
      display: flex;
      align-items: center;
      gap: 1.75rem;
      position: static;
      padding: 0;
      background: transparent;
      border: 0;
      box-shadow: none;
    }

    .nav__list {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
    }

    .nav__list a {
      min-height: auto;
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.92);
    }

    .site-header.is-solid .nav__list a {
      color: var(--color-charcoal-soft);
    }

    .nav__list a:hover {
      color: var(--color-green-bright);
    }

    .site-header.is-solid .nav__list a:hover {
      color: var(--color-green);
    }

    .header-cta {
      width: auto;
    }
  }
</style>

<script>
  function initNav() {
    const header = document.querySelector('[data-header]');
    const toggle = document.querySelector('[data-menu-toggle]');
    const nav = document.querySelector('[data-nav]');
    if (!(header instanceof HTMLElement)) return;
    if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

    const label = toggle.querySelector('.visually-hidden');

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
      if (open) header.classList.add('is-solid');
      else if (window.scrollY < 40) header.classList.remove('is-solid');
      if (label) label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    };

    const onScroll = () => {
      if (window.scrollY > 40 || toggle.getAttribute('aria-expanded') === 'true') {
        header.classList.add('is-solid');
      } else {
        header.classList.remove('is-solid');
      }
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
    });

    nav.querySelectorAll('[data-nav-link], .header-cta').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      if (!nav.contains(event.target) && !toggle.contains(event.target)) {
        setOpen(false);
      }
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  initNav();
</script>
