---
import { Image } from 'astro:assets';
import bioImage from '../assets/images/bio-clase.jpg';
import {
  contacts,
  isValidWhatsApp,
  buildWhatsAppUrl,
  courseInquiryMessage,
} from '../data/contacts';
import { social } from '../data/social';

const whatsappReady = isValidWhatsApp(contacts.whatsappNumber);
const href = whatsappReady
  ? buildWhatsAppUrl(contacts.whatsappNumber!, courseInquiryMessage('los cursos'))
  : social.pragaInstagram;
const label = whatsappReady ? 'Consultar por WhatsApp' : 'Consultar por Instagram';
---

<section class="banner" aria-labelledby="banner-title">
  <div class="banner__media" aria-hidden="true">
    <Image
      src={bioImage}
      alt=""
      widths={[900, 1400, 1800]}
      sizes="100vw"
      loading="lazy"
      class="banner__img"
    />
    <div class="banner__overlay"></div>
  </div>
  <div class="container banner__content">
    <div>
      <p class="banner__eyebrow">Próximo paso</p>
      <h2 id="banner-title">Empezá tu camino al volante con Praga</h2>
      <p>
        Cursos para principiantes, perfeccionamiento y refuerzos. Coordiná tu consulta y confirmá
        disponibilidad directamente con la escuela.
      </p>
    </div>
    <a
      class="btn btn--primary"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      data-track="course_cta"
      data-section="banner"
      data-course-id="general"
    >
      {label}
    </a>
  </div>
</section>

<style>
  .banner {
    position: relative;
    overflow: hidden;
    color: #fff;
  }

  .banner__media {
    position: absolute;
    inset: 0;
  }

  .banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .banner__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg, rgba(16, 118, 77, 0.92), rgba(48, 62, 112, 0.88));
  }

  .banner__content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(3.5rem, 8vw, 5.5rem);
    align-items: center;
  }

  .banner__eyebrow {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #b7ebcf;
  }

  .banner__content h2 {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .banner__content p {
    margin: 0;
    max-width: 36rem;
    color: rgba(255, 255, 255, 0.88);
  }

  @media (min-width: 800px) {
    .banner__content {
      grid-template-columns: 1fr auto;
      gap: 2.5rem;
    }
  }
</style>
