---
/**
 * Mobile bottom CTA links to #cursos (in-page), not WhatsApp.
 * WhatsApp icon is only shown when the destination itself is WhatsApp.
 */
---

<div class="mobile-cta" data-mobile-cta>
  <a
    class="btn btn--primary mobile-cta__btn"
    href="#cursos"
    data-track="course_cta"
    data-section="mobile-cta"
    data-course-id="general"
  >
    Consultar cursos
  </a>
</div>

<style>
  .mobile-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    padding: 0.85rem var(--gutter) calc(0.85rem + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.96) 38%);
    pointer-events: none;
  }

  .mobile-cta__btn {
    width: 100%;
    pointer-events: auto;
    box-shadow: var(--shadow-lift);
  }

  @media (min-width: 700px) {
    .mobile-cta {
      display: none;
    }
  }
</style>
