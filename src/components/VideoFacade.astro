---
interface Props {
  videoId: string;
  title: string;
  description?: string;
  featured?: boolean;
}

const { videoId, title, description, featured = false } = Astro.props;
const watchUrl = `https://www.youtube.com/watch?v=${videoId}`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
const thumb = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---

<article class:list={['video', { 'video--featured': featured }]} data-video-facade>
  <div class="video__frame">
    <button
      class="video__facade"
      type="button"
      data-video-activate
      data-video-id={videoId}
      data-embed-url={embedUrl}
      aria-label={`Reproducir video: ${title}`}
    >
      <img src={thumb} alt="" width="480" height="270" loading="lazy" />
      <span class="video__play" aria-hidden="true"></span>
    </button>
  </div>
  <div class="video__meta">
    <h3 class="video__title">{title}</h3>
    {description && <p class="video__desc">{description}</p>}
    <a class="video__fallback" href={watchUrl} target="_blank" rel="noopener noreferrer">
      Ver en YouTube
    </a>
  </div>
</article>

<style>
  .video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #111;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .video__facade,
  .video__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__facade {
    padding: 0;
    cursor: pointer;
    background: #111;
  }

  .video__facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video__play {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 3.5rem;
    height: 3.5rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: rgba(16, 118, 77, 0.95);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .video__play::before {
    content: '';
    position: absolute;
    left: 52%;
    top: 50%;
    transform: translate(-40%, -50%);
    border-style: solid;
    border-width: 0.55rem 0 0.55rem 0.9rem;
    border-color: transparent transparent transparent #fff;
  }

  .video__meta {
    padding-top: 0.85rem;
  }

  .video__title {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .video--featured .video__title {
    font-size: 1.25rem;
  }

  .video__desc {
    margin: 0 0 0.5rem;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .video__fallback {
    font-size: 0.9rem;
    color: var(--color-blue);
  }
</style>

<script>
  import { trackEvent } from '../scripts/analytics';

  document.querySelectorAll('[data-video-activate]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!(button instanceof HTMLButtonElement)) return;
      const frame = button.closest('.video__frame');
      const embedUrl = button.dataset.embedUrl;
      const videoId = button.dataset.videoId;
      if (!frame || !embedUrl) return;

      const iframe = document.createElement('iframe');
      iframe.src = embedUrl;
      iframe.title = button.getAttribute('aria-label') || 'Video de YouTube';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.loading = 'lazy';
      frame.replaceChildren(iframe);

      trackEvent('video_activation', {
        section: 'youtube',
        label: videoId,
      });
    });
  });
</script>
